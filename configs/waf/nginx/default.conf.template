log_format lb '$remote_addr -> $upstream_addr $status "$request"';
server_tokens off;

upstream apps {
    hash $remote_addr consistent;
    server 10.0.1.2:80 max_fails=3 fail_timeout=10s;
    server 10.0.2.2:80 max_fails=3 fail_timeout=10s;
}

server {
    listen 8080;
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/nginx/certs/latifa.crt;
    ssl_certificate_key /etc/nginx/certs/latifa.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://apps;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        access_log /dev/stdout lb;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_hide_header X-Powered-By;
        proxy_cookie_flags ~ secure;
    }

    location = /dashboard {
        allow 192.168.80.254;
        deny all;
        alias /etc/nginx/dashboard/index.html;
        default_type text/html;
        add_header Cache-Control "no-store" always;
    }

    location = /status/waf {
        if ($remote_addr != 192.168.80.254) { return 403; }
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "https://www.latifa.test" always;
        return 200 '{"node":"${NODE_NAME}"}';
    }

    location = /status.php {
        allow 192.168.80.254;
        deny all;
        proxy_pass http://apps;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /status/app1 {
        allow 192.168.80.254;
        deny all;
        proxy_pass http://10.0.1.2/status.php;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location = /status/app2 {
        allow 192.168.80.254;
        deny all;
        proxy_pass http://10.0.2.2/status.php;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    include includes/location_common.conf;
}
